@@ -171,15 +171,15 @@ format_hr <- function(hr, lower, upper, digits = 2) {
   paste0(f(hr), " (", f(lower), " to ", f(upper), ")")
 }

-## ---- fn-age-group
+## ---- fn-age-groups
 # Age groups from cut points (Dr. Lin, #20): each group includes its lower cut and
-# excludes its upper one, e.g. c(50, 60, 70, 80, Inf) gives "50-59", "60-69", "70-79",
+# excludes its upper one, e.g. c(50, 60, 70, 80, Inf) gives "50 to 59", "60 to 69", "70 to 79",
 # "80 or above". Whole-year labels, as ages in flchain are whole years.
 age_group <- function(age, cuts) {
   lower <- cuts[-length(cuts)]
   upper <- cuts[-1]
   labels <- ifelse(is.infinite(upper), paste0(lower, " or above"),
-                   paste0(lower, "–", upper - 1))
+                   paste0(lower, " to ", upper - 1))
   cut(age, breaks = cuts, right = FALSE, labels = labels)
 }

